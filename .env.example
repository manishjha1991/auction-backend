# Copy to .env and fill in real values. Never commit .env.

# Atlas (default cluster for this project). Replace USER, PASSWORD, and optional DB name before use.
#MONGO_URI=mongodb+srv://USER:PASSWORD@auction-app.z20al.mongodb.net/your-db?retryWrites=true&w=majority&appName=auction-app
# Database name (required when URI has no /path — matches server.js default)
# MONGO_DB_NAME=cpl_20
# Local dev fallback:
# MONGO_URI=mongodb://localhost:27017/your-db

# Optional: comma-separated DB names for team career aggregation (default cpl_12,…,cpl_20). Used by utils/teamCareerStats.js
# CPL_TEAM_CAREER_DBS=cpl_12,cpl_13,cpl_14,cpl_15,cpl_16,cpl_17,cpl_18,cpl_19,cpl_20
# CPL_TEAM_CAREER_CACHE_SEC=180
# CPL_TEAM_CAREER_PARALLEL=6

# Bid queue / auto-proxy (default off; no behaviour change unless true)
# ENABLE_BID_QUEUE=true

# Optional: portrait folder name (default cricket-player-portraits), same as wiki script
# PLAYER_PORTRAIT_DIR=cricket-player-portraits

# Optional: LLM “AI summary” on Ground atlas (/api/player-stats/venue-insight)
# Free tier: Google Gemini — create a key at https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# Optional; omit to auto-try gemini-2.0-flash, 2.5-flash, etc. (1.5 names are often retired)
# GEMINI_VENUE_MODEL=gemini-2.0-flash
# Paid option: OpenAI
# OPENAI_API_KEY=sk-...
# OPENAI_VENUE_MODEL=gpt-4o-mini
# auto = use Gemini if GEMINI_API_KEY is set, else OpenAI (default). Or: gemini | openai
# With both keys, auto retries the summary with OpenAI if Gemini hits quota/rate limits.
# VENUE_AI_PROVIDER=auto
# VENUE_AI_AUTO_OPENAI_FALLBACK=1
# Retries on 429/503 (shared by both providers)
# VENUE_AI_MAX_ATTEMPTS=2
# OPENAI_VENUE_MAX_ATTEMPTS=2
# Master switch (also OPENAI_VENUE_ENABLED for backward compatibility)
# VENUE_AI_ENABLED=1
# OPENAI_VENUE_ENABLED=1
# Hide quota banner (heuristics still load)
# VENUE_AI_HIDE_QUOTA_ERRORS=0
# OPENAI_VENUE_HIDE_QUOTA_ERRORS=0
